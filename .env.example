# ──────────────────────────────────────────────────────────────
# ResourceHub — Environment variables
# Copy this file to .env and fill in production values.
# ──────────────────────────────────────────────────────────────

# Database (Postgres on AWS RDS)
DATABASE_URL=postgresql+psycopg2://resourcehub:CHANGE_ME@your-rds-endpoint.rds.amazonaws.com:5432/resourcehub

# Cookie signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX

# Set to 'false' in production
DEBUG=false
